# Copy to .env and edit. Nothing else in the code reads os.environ.

# ---------- Qdrant ----------
# "server" strongly recommended: real HNSW index, payload indexes, and ingest
# can run while the API is up. "local" takes an exclusive lock on the folder,
# so ingest and API cannot both run, and it brute-force scans every query.
QDRANT_MODE=server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gov_schemes
# Only used when QDRANT_MODE=local
QDRANT_LOCAL_PATH=C:\Users\bomma\Documents\RAG\myscheme-ai\vector-db
# QDRANT_API_KEY=

# Your corpus measures 12,811 chunks: ~52 MB of fp32 dense vectors, ~15 MB
# sparse, ~12 MB payload. Under 100 MB total, so keep everything in RAM at
# full precision -- best recall and lowest latency, no downside at this size.
# Flip both to true past roughly 500k chunks, when RAM becomes the constraint.
QDRANT_ON_DISK=false
QDRANT_QUANTIZATION=false
# Immutable after creation. 4 shards is free on one node and lets you add
# nodes later and rebalance rather than re-ingesting.
QDRANT_SHARD_NUMBER=4

# ---------- Embeddings (BGE-M3, still local) ----------
# Embeddings stay local on purpose. They are free, they need no network round
# trip, and BGE-M3 produces dense AND sparse vectors from one forward pass --
# the sparse half is what matches acronyms like "PM-KISAN" that a dense model
# paraphrases away. A hosted embedding API would be dense-only, so hybrid
# search would quietly become single-vector search, and swapping models means
# re-embedding all 12,811 chunks.
#
# cuda now that generation is hosted: nothing else is on the card, so the
# ~2.3 GB model fits and a query embedding drops from ~250 ms to ~25 ms.
# Set to cpu if you would rather keep the GPU free.
EMBED_DEVICE=cuda
EMBED_BATCH_SIZE=32
EMBED_STORE_SPARSE=true
# Set once the API runs more than one worker (BGE-M3 is ~2.3 GB per worker)
# EMBED_SERVICE_URL=http://localhost:8081

# ---------- LLM (Gemini) ----------
# Gemini exposes an OpenAI-compatible endpoint, so the client code is
# unchanged from when this ran a local Qwen -- only these lines differ.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# >>> PASTE YOUR GEMINI API KEY HERE <<<
# Get one at https://aistudio.google.com/apikey
# .env is in .gitignore; keep it that way and never commit the key.
LLM_API_KEY=api-key-here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.1
# If the model name is wrong you get a 404 that names no alternative. Run
#     python scripts/check_llm.py --list-models
# to print exactly what your key can call, then correct the line above.
#
# Room for an answer AFTER the model's thinking tokens, which are billed
# against this limit. Too low and you get an empty answer, not a short one.
LLM_MAX_TOKENS=2048
# ~20k tokens of sources. Raise for broader context, lower to cut cost; this
# is the main lever on both. (It was 3500 for a local 4B, which lost the
# thread past ~8k.)
LLM_CONTEXT_BUDGET_TOKENS=20000
# Caps deliberation. Answering from retrieved text needs none: the reasoning
# is already in the sources. "none" | "minimal" | "low" | "medium" | "high".
# Note "none" is REJECTED by models that cannot disable thinking (Gemini 2.5
# Pro and the Gemini 3 family), so "low" is the portable choice.
LLM_REASONING_EFFORT=low
# Added to EVERY request's max_tokens to pay for thinking, which Gemini bills
# against the same ceiling. Each agent budgets for its OUTPUT; this covers the
# deliberation on top. It is a ceiling, not a spend -- unused tokens are free.
#
# Without it the eligibility assessor returned truncated, unparseable JSON on
# the turn where it had to reconcile the user's answers against its criteria,
# and that surfaced as "not enough information to decide" after the user had
# answered every question. Raise it if the log shows unparseable output.
# Set to 0 when serving a non-thinking model.
LLM_THINKING_HEADROOM_TOKENS=1536
# Retries for TRANSIENT failures only -- 429 (rate limited) and 5xx (provider
# overloaded). Separate from the OpenAI SDK's own max_retries, which stays 0
# because it retries timeouts too and turns one 60 s wait into three.
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_DELAY=2.0
LLM_RETRY_MAX_DELAY=60.0
# Client-side requests-per-minute ceiling, across every agent. 0 = off.
#
# Leave off for interactive use. Set it for BATCH work: the 85-question
# evaluation makes ~10 calls per question, and firing ~850 requests back to
# back returns 429 within the first few questions on a free-tier key. Retries
# alone cannot fix a sustained overrun, only pacing can.
#   free tier:  10-15      paid tier: leave at 0 or set it high
# scripts\evaluate_rag.py --rpm N overrides this for one run.
LLM_MAX_REQUESTS_PER_MINUTE=0
# Cost reporting rates, per 1M tokens. From your provider's pricing page --
# evaluate_rag.py prints which rates it used.
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.40
# Only for serving Qwen locally again -- appends Qwen3's /no_think switch,
# which is just prompt noise to Gemini.
LLM_NO_THINK_SUFFIX=false
# Provider options the OpenAI schema has no field for. Gemini:
# LLM_EXTRA_BODY={"google": {"thinking_config": {"thinking_budget": 0}}}
# Ollama >= 0.9: LLM_EXTRA_BODY={"think": false}

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=24
# 8 now that the context budget is no longer the constraint. Recall is what
# limits answer quality once the right document is scoped, and a hosted model
# reads 8 chunks as happily as 5.
RETRIEVAL_FINAL_K=8
RETRIEVAL_HYBRID=true
# Calibrate on your own questions: run scripts/query.py --search-only and
# watch the gate score for questions the corpus does and does not cover.
RETRIEVAL_MIN_SCORE=0.35
RERANK_ENABLED=false
# Evidence Verification is a second full LLM call: ~2x latency and cost. It
# was unusable on a local 4B (observed: 116 s, unparseable output); a hosted
# model handles it, so this is now a cost choice. Worth trying as `true`.
VERIFY_ENABLED=false

# ---------- Agents ----------
# HyDE fires ONLY when scheme resolution finds nothing confident. For a named
# scheme it cannot improve on a correct document id and risks dragging
# retrieval elsewhere, so it is skipped there regardless of this flag.
HYDE_ENABLED=true
HYDE_MAX_TOKENS=200
# Shortlist size for "suggest schemes for me"
DISCOVERY_MAX_SCHEMES=6
# ROUNDS, not questions. One round asks about every unresolved criterion at
# once; the UI walks the user through them with Yes/No buttons and posts the
# answers back already paired to their questions. After this many rounds the
# agent commits to a verdict and names what is still unknown.
# (This was ELIGIBILITY_MAX_QUESTIONS, which matched no setting and was
# therefore silently ignored.)
ELIGIBILITY_MAX_ROUNDS=3

# ---------- Paths ----------
RAW_DIR=C:\Users\bomma\Documents\RAG\myscheme-ai\schemes_txt
PROCESSED_DIR=data/processed

# ---------- API ----------
API_PORT=8080

# ---------- Langfuse (LLM/RAG observability) ----------
# Self-hosted stack, started separately:  .\ops\langfuse\up.ps1
# Dashboard at http://localhost:3000 -- which is why Grafana moved to 3001
# and Prometheus to 9091 (Langfuse's MinIO publishes on 9090).
LANGFUSE_ENABLED=false
# These must match LANGFUSE_INIT_PROJECT_* in ops\langfuse\langfuse.env, which
# bootstraps the project on first start so the keys are valid before you have
# opened the dashboard. Otherwise copy them from Settings -> API keys.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# BASE_URL, not HOST: the SDK renamed it in v5 and most tutorials are stale.
LANGFUSE_BASE_URL=http://localhost:3000
# Separates local experiments from real traffic in the dashboard.
LANGFUSE_ENVIRONMENT=development
# 1.0 traces everything. Lower only under load -- sampling costs you exactly
# the rare failure you most wanted to look at.
LANGFUSE_SAMPLE_RATE=1.0
# Redact the user's personal details before they leave the process.
# OFF by default: on a local single-developer setup the profile is the most
# useful thing in a trace. Turn it ON before this serves real people -- the
# eligibility interview collects age, income, caste category and disability
# status, and an observability backend should not be where that data is least
# protected.
LANGFUSE_MASK_PII=false
# Verify the whole path:  python scripts\check_llm.py --check-tracing

# ---------- Observability ----------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gov-schemes-rag
METRICS_ENABLED=true
LOG_LEVEL=INFO

GRAFANA_PASSWORD=admin
